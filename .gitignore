# ---------------- 运行时环境 ----------------
# 便携 Python + 依赖库，1.2 GB。源码仓库不需要它，现场部署时用 build_release.py 重新打
runtime/

# ---------------- 业务数据（含敏感信息，绝不入库）----------------
# data/captures  板照片 435 MB
# data/backup    全量备份 752 MB
# data/auth      账号密码哈希、身份证后 6 位
# data/audit     审计日志（哈希链）
# data/kb        知识库原件（可能含客户资料）
# data/devices.json 现场设备配置
data/

# ---------------- 第三方 SDK ----------------
# 海康 MVS + 运动控制卡 DLL，74 MB，按授权不应随源码分发
libs/

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# ---------------- 打包 / 备份 / 临时产物 ----------------
发布/
备份/
tmp_img/
*.zip

# ---------------- Office 临时锁文件 ----------------
~$*

# ---------------- 日志 ----------------
*.log

# ---------------- 编辑器 / 系统 ----------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------------- 本地配置覆盖 ----------------
*.local.json
